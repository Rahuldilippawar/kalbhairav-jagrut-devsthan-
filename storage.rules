rules_version = '2';

// Public media (banners, gallery, event photos) is readable by everyone and
// uploaded by admins. Devotees may upload their own profile photo.
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() { return request.auth != null && request.auth.token.get('role', null) != null; }
    function isImage() { return request.resource.contentType.matches('image/.*'); }

    match /public/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() && request.resource.size < 15 * 1024 * 1024
        && (isImage() || request.resource.contentType.matches('video/.*'));
    }

    match /users/{userId}/{allPaths=**} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow write: if request.auth != null && request.auth.uid == userId
        && isImage() && request.resource.size < 5 * 1024 * 1024;
    }
  }
}
