rules_version = '2';

// Public media (banners, gallery, event photos) is readable by everyone and
// uploaded by admins. Devotees may upload their own profile photo.
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() { return request.auth != null && request.auth.token.get('role', null) != null; }
    function isImage() { return request.resource.contentType.matches('image/.*'); }

    match /public/{allPaths=**} {
      allow read: if true;
      // Photos up to 15 MB, short darshan / utsav videos up to 200 MB.
      allow write: if isAdmin() && (
        (isImage() && request.resource.size < 15 * 1024 * 1024)
        || (request.resource.contentType.matches('video/.*') && request.resource.size < 200 * 1024 * 1024));
    }

    // Shishya parivar chat photos, videos and voice messages. Only shishya
    // logins (mobile + password) upload, each into their own folder; the
    // chat messages themselves are limited to approved shishyas in
    // firestore.rules.
    match /shishya_chat/{userId}/{file} {
      function shishyaLogin() {
        return request.auth != null && request.auth.token.get('email', '').matches('.*@shishya[.]kalbhairav[.]app');
      }
      allow read: if shishyaLogin() || isAdmin();
      allow create: if shishyaLogin() && request.auth.uid == userId && (
        (isImage() && request.resource.size < 15 * 1024 * 1024)
        || (request.resource.contentType.matches('video/.*') && request.resource.size < 100 * 1024 * 1024)
        || (request.resource.contentType.matches('audio/.*') && request.resource.size < 15 * 1024 * 1024));
      allow delete: if (request.auth != null && request.auth.uid == userId) || isAdmin();
    }

    match /users/{userId}/{allPaths=**} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow write: if request.auth != null && request.auth.uid == userId
        && isImage() && request.resource.size < 5 * 1024 * 1024;
    }
  }
}
