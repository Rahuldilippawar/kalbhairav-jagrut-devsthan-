rules_version = '2';

// Kalbhairav Jagrut Devsthan – Firestore security rules.
//
// * Public temple content is world-readable; only admins with the right
//   module (see roleModules) can change it.
// * Money documents (payments, donations, receipts, seva_bookings,
//   counters, slot counts) are written ONLY by Cloud Functions (Admin SDK
//   bypasses rules). Devotees can read their own.
// * Admin roles live in the `role` custom claim set by setAdminRole.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---- helpers -------------------------------------------------------
    function signedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }
    function role() { return signedIn() ? request.auth.token.get('role', null) : null; }

    // Keep in sync with packages/kjd_core/lib/src/rbac.dart and functions/src/rbac.ts.
    function roleModules() {
      return {
        'super_admin': ['dashboard','temple','darshan','events','seva','bookings','checkIn','donations','payments','devotees','content','banners','gallery','live','notifications','reports','users','settings','auditLogs'],
        'temple_admin': ['dashboard','temple','darshan','events','seva','bookings','checkIn','donations','payments','devotees','content','banners','gallery','live','notifications','reports','settings','auditLogs'],
        'event_manager': ['dashboard','events','gallery','live','notifications'],
        'seva_manager': ['dashboard','seva','bookings','checkIn','devotees','reports'],
        'accounts_manager': ['dashboard','donations','payments','bookings','reports'],
        'content_manager': ['dashboard','temple','darshan','content','banners','live','notifications'],
        'gallery_manager': ['dashboard','gallery'],
        'volunteer': ['dashboard','checkIn']
      };
    }
    function isAdmin() { return role() != null && role() in roleModules(); }
    function can(m) { return isAdmin() && m in roleModules()[role()]; }
    function owns(data) { return signedIn() && data.userId == uid(); }

    // ---- public content ------------------------------------------------
    match /temple_info/{id} { allow read: if true; allow write: if can('temple'); }
    match /home_banners/{id} { allow read: if true; allow write: if can('content') || can('temple'); }
    match /darshan_schedule/{id} { allow read: if true; allow write: if can('darshan'); }
    match /deities/{id} { allow read: if true; allow write: if can('temple'); }
    match /gadhipati_parampara/{id} { allow read: if true; allow write: if can('temple'); }
    match /gadhipati_vanshavali/{id} { allow read: if true; allow write: if can('temple'); }
    match /festival_dates/{id} { allow read: if true; allow write: if can('content'); }
    match /darshan_photos/{id} { allow read: if true; allow write: if can('live') || can('darshan') || can('gallery'); }
    match /live_darshan/{id} { allow read: if true; allow write: if can('live'); }
    match /app_settings/{id} { allow read: if true; allow write: if can('settings'); }

    match /events/{id} {
      allow read: if resource.data.status in ['published', 'completed'] || can('events') || can('notifications');
      allow write: if can('events');
    }
    match /event_categories/{id} { allow read: if true; allow write: if can('events'); }
    match /event_schedules/{id} { allow read: if true; allow write: if can('events'); }
    match /event_media/{id} { allow read: if true; allow write: if can('events') || can('gallery'); }

    match /daily_quotes/{id} { allow read: if true; allow write: if can('content'); }
    match /daily_greetings/{id} { allow read: if true; allow write: if can('content'); }
    match /tithi_content/{id} { allow read: if true; allow write: if can('content'); }
    match /mantras/{id} { allow read: if true; allow write: if can('content'); }
    // Built daily by Cloud Functions from devotees who chose "Public".
    match /public_greetings/{id} { allow read: if true; allow write: if false; }
    match /announcements/{id} { allow read: if true; allow write: if can('content') || can('notifications'); }
    match /banner_templates/{id} { allow read: if true; allow write: if can('banners'); }
    match /gallery/{id} { allow read: if true; allow write: if can('gallery'); }
    match /videos/{id} { allow read: if true; allow write: if can('gallery') || can('events') || can('live'); }
    match /sevas/{id} { allow read: if true; allow write: if can('seva'); }
    match /seva_slot_counts/{id} { allow read: if true; allow write: if false; }

    // ---- Guru Gyan (shishya parivar) ------------------------------------
    // A shishya asks for access (status 'pending'); temple management
    // approves through the reviewShishya function. Lessons are readable only
    // by approved shishyas and staff.
    function shishyaRequestKeys() { return ['name','mobile','village','guruName','note','status','requestedAt']; }
    match /shishyas/{userId} {
      allow read: if (signedIn() && uid() == userId) || can('devotees');
      allow create: if signedIn() && uid() == userId
        && request.resource.data.status == 'pending'
        && request.resource.data.keys().hasOnly(shishyaRequestKeys())
        && request.resource.data.name is string && request.resource.data.name.size() > 0
        && request.resource.data.mobile is string;
      allow update: if can('devotees')
        || (signedIn() && uid() == userId && (
          // Ask again after a rejection (or edit a waiting request).
          (resource.data.status in ['pending', 'rejected'] && request.resource.data.status == 'pending'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(shishyaRequestKeys()))
          // Reading progress.
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['completed'])
            && request.resource.data.completed is list && request.resource.data.completed.size() <= 1000)));
      allow delete: if can('devotees');
    }
    function approvedShishya() {
      return signedIn() && exists(/databases/$(database)/documents/shishyas/$(uid()))
        && get(/databases/$(database)/documents/shishyas/$(uid())).data.status == 'approved';
    }
    // Gadhipatis (set by the super admin) see what every shishya reads.
    function gadhipati() {
      return signedIn() && exists(/databases/$(database)/documents/gadhipatis/$(uid()));
    }
    match /gadhipatis/{userId} {
      allow read: if (signedIn() && uid() == userId) || can('devotees');
      allow write: if can('users');
    }
    // One row per lesson / granth chapter / mantra a shishya opened; the
    // shishya's app adds it and then only reports the time spent.
    match /shishya_activity/{id} {
      allow read: if gadhipati() || can('devotees');
      allow create: if approvedShishya()
        && request.resource.data.keys().hasOnly(['uid','name','kind','itemId','title','startedAt','lastAt','seconds'])
        && request.resource.data.uid == uid()
        && request.resource.data.kind in ['lesson', 'granth', 'mantra']
        && request.resource.data.title is string && request.resource.data.title.size() <= 300
        && request.resource.data.name is string && request.resource.data.name.size() <= 100
        && request.resource.data.seconds == 0
        && request.resource.data.startedAt == request.time;
      allow update: if signedIn() && resource.data.uid == uid()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seconds', 'lastAt'])
        && request.resource.data.seconds is int
        && request.resource.data.seconds >= resource.data.seconds
        && request.resource.data.seconds <= 86400
        && request.resource.data.lastAt == request.time;
      allow delete: if can('devotees');
    }
    // Shishya parivar group chat: approved shishyas only. Gadhipatis and
    // staff who manage devotees can read and remove any message.
    match /shishya_chat/{id} {
      allow read: if approvedShishya() || gadhipati() || can('devotees');
      allow create: if approvedShishya()
        && request.resource.data.keys().hasOnly(['uid','name','kind','text','mediaUrl','durationMs','createdAt',
          'replyToId','replyName','replyText'])
        && (!('replyText' in request.resource.data) || (request.resource.data.replyText is string
            && request.resource.data.replyText.size() <= 300))
        && request.resource.data.uid == uid()
        && request.resource.data.name is string && request.resource.data.name.size() <= 100
        && request.resource.data.createdAt == request.time
        && (!('text' in request.resource.data) || (request.resource.data.text is string
            && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 2000))
        && (request.resource.data.kind == 'text'
          ? ('text' in request.resource.data && !('mediaUrl' in request.resource.data))
          : (request.resource.data.kind in ['image', 'video', 'voice']
            && request.resource.data.mediaUrl is string
            && request.resource.data.mediaUrl.matches('https://firebasestorage[.]googleapis[.]com/.*')))
        && (!('durationMs' in request.resource.data) || (request.resource.data.durationMs is int
            && request.resource.data.durationMs <= 15 * 60 * 1000));
      allow update: if false;
      allow delete: if (signedIn() && resource.data.uid == uid()) || gadhipati() || can('devotees');
    }
    // How far each shishya has read the chat ("seen" ticks, unread counts).
    match /shishya_chat_reads/{userId} {
      allow read: if approvedShishya() || gadhipati() || can('devotees');
      allow write: if approvedShishya() && uid() == userId
        && request.resource.data.keys().hasOnly(['name', 'readAt'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 100
        && request.resource.data.readAt == request.time;
    }
    match /guru_gyan/{id} {
      allow read: if approvedShishya() || can('content') || can('devotees');
      allow write: if can('content');
    }
    // Granths (e.g. Katha-Kalpataru): chapter list and chapter texts.
    match /granth/{id} {
      allow read: if approvedShishya() || can('content') || can('devotees');
      allow write: if can('content');
    }
    match /granth_text/{id} {
      allow read: if approvedShishya() || can('content') || can('devotees');
      allow write: if can('content');
    }

    // ---- devotee data --------------------------------------------------
    match /users/{userId} {
      // Devotee PII: self, or staff who manage devotees. (Notifications are
      // fanned out by Cloud Functions, which don't need this rule.)
      allow read: if (signedIn() && uid() == userId) || can('devotees');
      allow create, update: if signedIn() && uid() == userId
        && request.resource.data.keys().hasOnly([
          'name','nameLower','mobile','email','village','photoUrl','dob','dobMonthDay','anniversary',
          'anniversaryMonthDay','spouseName','birthdayPrivacy','language','notificationsEnabled',
          'createdAt','updatedAt'])
        && (request.resource.data.mobile == request.auth.token.get('phone_number', request.resource.data.mobile));
      allow delete: if false;

      match /tokens/{token} {
        allow read, write: if signedIn() && uid() == userId;
      }
    }

    match /family_members/{id} {
      allow read: if owns(resource.data) || can('devotees');
      allow create: if owns(request.resource.data);
      allow update: if owns(resource.data) && owns(request.resource.data);
      allow delete: if owns(resource.data);
    }

    match /event_reminders/{id} {
      // `get` by id must also work before the reminder exists (the app
      // watches it to render the "Remind me" toggle).
      allow get: if (signedIn() && id.matches('^' + uid() + '_.+$'))
        || (resource != null && owns(resource.data)) || can('events') || can('notifications');
      allow list: if owns(resource.data) || can('events') || can('notifications');
      allow create, update: if owns(request.resource.data) && id == uid() + '_' + request.resource.data.eventId;
      allow delete: if owns(resource.data);
    }

    match /generated_banners/{id} {
      allow read: if owns(resource.data) || can('banners');
      allow create: if owns(request.resource.data);
      allow update, delete: if owns(resource.data);
    }

    // ---- money: Cloud Functions only -----------------------------------
    match /payments/{id} { allow read: if owns(resource.data) || can('payments'); allow write: if false; }
    match /donations/{id} { allow read: if owns(resource.data) || can('donations') || can('reports'); allow write: if false; }
    match /receipts/{id} {
      allow read: if owns(resource.data) || can('donations') || can('bookings') || can('reports');
      allow write: if false;
    }
    match /seva_bookings/{id} {
      allow read: if owns(resource.data) || can('bookings') || can('checkIn') || can('reports');
      allow write: if false;
    }
    match /counters/{id} { allow read, write: if false; }
    match /upi_utrs/{id} { allow read, write: if false; }

    // ---- notifications -------------------------------------------------
    match /notifications/{id} {
      allow read: if resource.data.target == 'all'
        || (signedIn() && resource.data.target == 'user' && resource.data.targetId == uid())
        || can('notifications');
      allow create: if can('notifications') && !('sentAt' in request.resource.data);
      allow update: if can('notifications') && !('sentAt' in resource.data);
      allow delete: if can('notifications');
    }

    // ---- administration ------------------------------------------------
    match /admin_users/{adminId} {
      allow read: if (signedIn() && uid() == adminId) || can('users') || can('auditLogs');
      allow write: if false; // setAdminRole function only
    }
    match /audit_logs/{id} {
      allow read: if can('auditLogs');
      allow create: if isAdmin() && request.resource.data.actorId == uid();
      allow update, delete: if false;
    }
  }
}
