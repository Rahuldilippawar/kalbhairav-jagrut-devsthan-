# Copy to functions/.env.<project-id> (not committed).
# Publishable Razorpay key id (rzp_live_… / rzp_test_…)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
# Comma separated emails allowed to claim the first super admin seat.
BOOTSTRAP_SUPER_ADMIN_EMAILS=owner@example.com

# Secrets are NOT stored here. Set them with:
#   firebase functions:secrets:set RAZORPAY_KEY_SECRET
#   firebase functions:secrets:set RAZORPAY_WEBHOOK_SECRET
